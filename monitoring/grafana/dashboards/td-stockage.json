{
 "uid": "td-stockage",
 "title": "TD Stockage – énergie & résultats",
 "schemaVersion": 39,
 "version": 1,
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "refresh": "10s",
 "tags": [
  "greenit",
  "td-stockage"
 ],
 "annotations": {
  "list": [
   {
    "builtIn": 1,
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "hide": true,
    "iconColor": "rgba(0, 211, 255, 1)",
    "name": "Annotations & Alerts",
    "type": "dashboard"
   },
   {
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "iconColor": "orange",
    "name": "Benchmarks TD",
    "target": {
     "type": "tags",
     "tags": [
      "td"
     ],
     "matchAny": true,
     "limit": 1000
    }
   }
  ]
 },
 "templating": {
  "list": [
   {
    "name": "fichier",
    "label": "Fichier",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prom-storing"
    },
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "allValue": ".*",
    "refresh": 2,
    "query": {
     "query": "label_values(td_compression_gain_pct, fichier)",
     "refId": "fichier"
    },
    "definition": "label_values(td_compression_gain_pct, fichier)"
   },
   {
    "name": "methode",
    "label": "Méthode d'échantillonnage",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prom-storing"
    },
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "allValue": ".*",
    "refresh": 2,
    "query": {
     "query": "label_values(td_echantillonnage_erreur_moy_pct, methode)",
     "refId": "methode"
    },
    "definition": "label_values(td_echantillonnage_erreur_moy_pct, methode)"
   },
   {
    "name": "jeu",
    "label": "Jeu de données",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prom-storing"
    },
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "allValue": ".*",
    "refresh": 2,
    "query": {
     "query": "label_values(td_db_duree_s, jeu)",
     "refId": "jeu"
    },
    "definition": "label_values(td_db_duree_s, jeu)"
   },
   {
    "name": "action",
    "label": "Action BDD",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prom-storing"
    },
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "allValue": ".*",
    "refresh": 2,
    "query": {
     "query": "label_values(td_db_duree_s, action)",
     "refId": "action"
    },
    "definition": "label_values(td_db_duree_s, action)"
   },
   {
    "name": "intensite",
    "label": "Intensité carbone (gCO₂e/kWh)",
    "type": "textbox",
    "query": "56",
    "current": {
     "text": "56",
     "value": "56"
    },
    "description": "Mix électrique ; ~56 France (ADEME), ~470 Tunisie. À adapter."
   },
   {
    "name": "facteur_machine",
    "label": "Facteur machine / CPU",
    "type": "textbox",
    "query": "1.5",
    "current": {
     "text": "1.5",
     "value": "1.5"
    }
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "Mesures en direct (RAPL + node-exporter)",
   "id": 1,
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "Puissance package actuelle",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "prom-storing"
   },
   "description": "Compteur RAPL du package CPU",
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom-storing"
     },
     "expr": "rate(node_rapl_package_joules_total{path=~\".*/intel-rapl:0\"}[30s])",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "watt"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "type": "stat",
   "title": "Énergie sur la période",
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "prom-storing"
   },
   "description": "Énergie package CPU consommée sur la plage de temps sélectionnée",
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom-storing"
     },
     "expr": "increase(node_rapl_package_joules_total{path=~\".*/intel-rapl:0\"}[$__range]) / 3600",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "watth",
     "decimals": 2
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "type": "stat",
   "title": "CO₂e sur la période",
   "id": 4,
   "datasource": {
    "type": "prometheus",
    "uid": "prom-storing"
   },
   "description": "Énergie (kWh) × intensité carbone du réseau (variable 'intensite', g CO₂e/kWh)",
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom-storing"
     },
     "expr": "increase(node_rapl_package_joules_total{path=~\".*/intel-rapl:0\"}[$__range]) / 3600 / 1000 * $intensite",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "massg",
     "decimals": 3
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "type": "stat",
   "title": "CPU moyen sur la période",
   "id": 5,
   "datasource": {
    "type": "prometheus",
    "uid": "prom-storing"
   },
   "description": "",
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom-storing"
     },
     "expr": "100 * (1 - avg(avg_over_time(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])[$__range:])))",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "type": "stat",
   "title": "Puissance moyenne sur la période",
   "id": 6,
   "datasource": {
    "type": "prometheus",
    "uid": "prom-storing"
   },
   "description": "",
   "gridPos": {
    "x": 16,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom-storing"
     },
     "expr": "increase(node_rapl_package_joules_total{path=~\".*/intel-rapl:0\"}[$__range]) / $__range_s",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "watt",
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "type": "stat",
   "title": "Estimation machine entière",
   "id": 7,
   "datasource": {
    "type": "prometheus",
    "uid": "prom-storing"
   },
   "description": "RAPL ne mesure que CPU (+ uncore). Estimation grossière de la machine entière : × facteur (variable).",
   "gridPos": {
    "x": 20,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom-storing"
     },
     "expr": "increase(node_rapl_package_joules_total{path=~\".*/intel-rapl:0\"}[$__range]) / 3600 * $facteur_machine",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "watth",
     "decimals": 2
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "type": "timeseries",
   "title": "Puissance RAPL (W) – zones annotées = benchmarks",
   "id": 8,
   "datasource": {
    "type": "prometheus",
    "uid": "prom-storing"
   },
   "description": "Les zones colorées sont les annotations envoyées par les scripts (push.py)",
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom-storing"
     },
     "expr": "rate(node_rapl_package_joules_total{path=~\".*/intel-rapl:0\"}[$__rate_interval])",
     "legendFormat": "package",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom-storing"
     },
     "expr": "rate(node_rapl_core_joules_total[$__rate_interval])",
     "legendFormat": "cœurs",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom-storing"
     },
     "expr": "rate(node_rapl_uncore_joules_total[$__rate_interval])",
     "legendFormat": "uncore (GPU intégré...)",
     "refId": "C"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "watt",
     "custom": {
      "fillOpacity": 10,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "CPU (%)",
   "id": 9,
   "datasource": {
    "type": "prometheus",
    "uid": "prom-storing"
   },
   "description": "",
   "gridPos": {
    "x": 12,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom-storing"
     },
     "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval])))",
     "legendFormat": "CPU total",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom-storing"
     },
     "expr": "100 * avg(rate(node_cpu_seconds_total{mode=\"iowait\"}[$__rate_interval]))",
     "legendFormat": "iowait",
     "refId": "B"
